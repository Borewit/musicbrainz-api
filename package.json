{
  "name": "musicbrainz-api",
  "version": "2.0.1",
  "description": "MusicBrainz API client for reading and submitting metadata",
  "exports": {
    "node": {
      "types": "./lib/entry-node.d.ts",
      "default": "./lib/entry-node.js"
    },
    "default": {
      "types": "./lib/entry-default.d.ts",
      "default": "./lib/entry-default.js"
    }
  },
  "types": "lib/entry-default.d.ts",
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "type": "module",
  "author": {
    "name": "Borewit",
    "url": "https://github.com/Borewit"
  },
  "keywords": [
    "MusicBrainz",
    "metadata",
    "meta",
    "tag",
    "tags",
    "Picard",
    "json",
    "xml",
    "web",
    "service",
    "submit",
    "metabrainz",
    "Cover Art Archive",
    "coverartarchive",
    "coverartarchive.org",
    "album art",
    "covers",
    "download covers"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": "github:Borewit/musicbrainz-api",
  "bugs": {
    "url": "https://github.com/Borewit/musicbrainz-api/issues"
  },
  "dependencies": {
    "debug": "^4.3.4",
    "http-status-codes": "^2.1.4",
    "json-stringify-safe": "^5.0.1",
    "jsontoxml": "^1.0.1",
    "rate-limit-threshold": "^0.2.0",
    "spark-md5": "^3.0.2",
    "uuid": "^14.0.0"
  },
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/chai": "^5.0.0",
    "@types/jsontoxml": "^1.0.5",
    "@types/mocha": "^10.0.4",
    "@types/node": "^25.0.3",
    "@types/sinon": "^22.0.0",
    "@types/spark-md5": "^3",
    "@types/uuid": "^11.0.0",
    "c8": "^12.0.0",
    "chai": "^6.2.0",
    "del-cli": "^7.0.0",
    "mocha": "^12.0.3",
    "remark-cli": "^12.0.0",
    "remark-preset-lint-recommended": "^7.0.0",
    "sinon": "^22.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "clean": "del-cli 'lib/**/*.js' 'lib/**/*.js.map' 'lib/**/*.d.ts' 'test/**/*.js' 'test/**/*.js.map'",
    "compile-lib:dev": "tsc -p lib/tsconfig.json",
    "compile-lib:prod": "tsc -p lib/tsconfig.prod.json",
    "compile-test": "tsc -p test",
    "compile:dev": "yarn run compile-lib:dev && yarn run compile-test",
    "compile:prod": "yarn run compile-lib:prod && yarn run compile-test",
    "lint:md": "remark -u preset-lint-recommended .",
    "lint:ts": "biome check",
    "lint:fix": "biome check --write",
    "lint": "yarn run lint:md && yarn run lint:ts",
    "test": "mocha",
    "test:compiled": "mocha --config .mocharc.compiled.json",
    "build:dev": "yarn run clean && yarn run compile:dev",
    "build:prod": "yarn run clean && yarn run compile:prod",
    "build": "yarn run build:prod",
    "start": "yarn run compile && yarn run lint && yarn run cover-test",
    "test-coverage": "c8 yarn run test",
    "test-coverage:compiled": "c8 yarn run test:compiled",
    "send-codacy": "c8 report --reporter=text-lcov | codacy-coverage",
    "prepublishOnly": "yarn run build:prod",
    "update-biome": "yarn add -D --exact @biomejs/biome && npx @biomejs/biome migrate --write && npm run lint:fix",
    "test:live": "mocha --config .mocharc.live.json",
    "test:live:compiled": "mocha --config .mocharc.live.compiled.json"
  },
  "nyc": {
    "exclude": [
      "test/**/*.ts"
    ],
    "extension": [
      ".ts"
    ],
    "sourceMap": true,
    "instrument": true,
    "reporter": [
      "lcov",
      "text"
    ],
    "report-dir": "coverage"
  },
  "packageManager": "yarn@4.18.1"
}
